@page
@model HotelWebApp.Pages.Bills.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Bill[0].Invoice)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Bill[0].PaymentDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Bill[0].TotalPrice)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Bill[0].IdaccountNavigation)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Bill[0].IdbookingNavigation)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Bill) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Invoice)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.PaymentDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.TotalPrice)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.IdaccountNavigation.Gender)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.IdbookingNavigation.Status)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.Idbill">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.Idbill">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.Idbill">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
