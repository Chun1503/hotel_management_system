@page
@model HotelWebApp.Pages.User.PaymentHistoryModel
@{
    ViewData["Title"] = "Lịch sử đặt phòng";
    var userName = HttpContext.Session.GetString("UserName");
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"]</title>

    <!-- Favicon -->
    <link rel="shortcut icon" type="image/icon" href="~/template/images/favicon.png" />

    <!-- CSS Files -->
    <link rel="stylesheet" href="~/template/css/bootstrap.min.css">
    <link rel="stylesheet" href="~/template/css/style.css">
    <link rel="stylesheet" href="~/template/css/responsive.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/1.11.5/css/dataTables.bootstrap5.min.css">
</head>
<body>
    <!-- Header -->
    <header id="header-top" class="header-top">
        <ul>
            <li class="head-responsive-right pull-right">
                <div class="header-top-right">
                    <ul>
                        @if (!string.IsNullOrEmpty(userName))
                        {
                            <li class="header-top-contact dropdown">
                                <a href="#" class="dropdown-toggle" data-toggle="dropdown">Xin chào, @userName <span class="caret"></span></a>
                                <ul class="dropdown-menu">
                                    <li><a asp-page="/User/Profile"><i class="fas fa-user-circle"></i> Hồ sơ</a></li>
                                    <li><a asp-page-handler="Logout"><i class="fas fa-sign-out-alt"></i> Đăng xuất</a></li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li><a asp-page="/Account/Login"><i class="fas fa-sign-in-alt"></i> Đăng nhập</a></li>
                            <li><a asp-page="/Account/Register"><i class="fas fa-user-plus"></i> Đăng ký</a></li>
                        }
                    </ul>
                </div>
            </li>
        </ul>
    </header>

    <!-- Main Content -->
    <div class="container mt-4">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h3 class="card-title mb-0">
                    <i class="fas fa-history"></i> Lịch sử đặt phòng
                </h3>
            </div>
            <div class="card-body">
                <!-- Thông báo -->
                @if (!string.IsNullOrEmpty(Model.ThongBao))
                {
                    <div class="alert alert-info alert-dismissible fade show">
                        @Model.ThongBao
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @if (Model.Bookings != null && Model.Bookings.Any())
                {
                    <div class="table-responsive">
                        <table id="bookingTable" class="table table-hover table-striped">
                            <thead class="table-dark">
                                <tr>
                                    <th>Mã đặt phòng</th>
                                    <th>Ngày nhận phòng</th>
                                    <th>Ngày trả phòng</th>
                                    <th>Đặt cọc</th>
                                    <th>Trạng thái</th>
                                    <th>Khách hàng</th>
                                    <th>SĐT</th>
                                    <th>Hành động</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var booking in Model.Bookings.OrderByDescending(b => b.StartDate))
                                {
                                    <tr>
                                        <td>@booking.Idbooking</td>
                                        <td>@booking.StartDate.ToString("dd/MM/yyyy")</td>
                                        <td>@booking.EndDate.ToString("dd/MM/yyyy")</td>
                                        <td class="fw-bold">@booking.Deposit.ToString("N0") ₫</td>
                                        <td>
                                            <span class="badge @GetStatusBadgeClass(booking.Status)">
                                                @GetStatusText(booking.Status)
                                            </span>
                                        </td>
                                        <td>@booking.CustomerName</td>
                                        <td>@booking.CustomerPhone</td>
                                        <td>
                                            <div class="btn-group" role="group">
                                                <a href="/User/BookingDetail/@booking.Idbooking" class="btn btn-sm btn-info" title="Chi tiết">
                                                    <i class="fas fa-eye"></i>
                                                </a>
                                                @if (booking.Status == "Pending" || booking.Status == "Confirmed")
                                                {
                                                    <button onclick="confirmCancel(@booking.Idbooking)" class="btn btn-sm btn-danger" title="Hủy">
                                                        <i class="fas fa-times"></i>
                                                    </button>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="alert alert-warning text-center">
                        <i class="fas fa-info-circle"></i> Bạn chưa có đơn đặt phòng nào.
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="~/template/js/jquery.min.js"></script>
    <script src="~/template/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.11.5/js/dataTables.bootstrap5.min.js"></script>
    <script>
        $(document).ready(function () {
            $('#bookingTable').DataTable({
                language: {
                    url: 'https://cdn.datatables.net/plug-ins/1.11.5/i18n/vi.json'
                },
                responsive: true,
                order: [[0, 'desc']]
            });
        });

        function confirmCancel(bookingId) {
            Swal.fire({
                title: 'Xác nhận hủy đơn?',
                text: "Bạn có chắc muốn hủy đơn đặt phòng này?",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Đồng ý hủy',
                cancelButtonText: 'Quay lại'
            }).then((result) => {
                if (result.isConfirmed) {
                    window.location.href = '/User/CancelBooking/' + bookingId;
                }
            });
        }
    </script>

    @functions {
        public string GetStatusBadgeClass(string status)
        {
            return status switch
            {
                "Paid" => "bg-success",
                "Confirmed" => "bg-primary",
                "Pending" => "bg-warning",
                "Cancelled" => "bg-secondary",
                "Completed" => "bg-info",
                _ => "bg-light text-dark"
            };
        }

        public string GetStatusText(string status)
        {
            return status switch
            {
                "Paid" => "Đã thanh toán",
                "Confirmed" => "Đã xác nhận",
                "Pending" => "Chờ xử lý",
                "Cancelled" => "Đã hủy",
                "Completed" => "Hoàn thành",
                _ => status
            };
        }
    }
</body>
</html>