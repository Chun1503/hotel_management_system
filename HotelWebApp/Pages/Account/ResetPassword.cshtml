@page "{email}"
@model HotelWebApp.Pages.Account.ResetPasswordModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Đặt Lại Mật Khẩu";
}

<div class="container d-flex justify-content-center align-items-center" style="height: 100vh;">
    <div class="card shadow-lg p-4 animated fadeIn" style="width: 400px; border-radius: 12px;">
        <h3 class="text-center text-primary fw-bold">Đặt Lại Mật Khẩu</h3>
        <hr />

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <p class="mb-1">@error.ErrorMessage</p>
                }
            </div>
        }

        <form method="post">
            <div class="mb-3">
                <label class="form-label fw-semibold">OTP</label>
                <div class="input-group">
                    <span class="input-group-text bg-light"><i class="fas fa-key"></i></span>
                    <input asp-for="Input.OtpCode" class="form-control" placeholder="Nhập OTP" />
                </div>
                <span asp-validation-for="Input.OtpCode" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Mật khẩu mới</label>
                <div class="input-group">
                    <span class="input-group-text bg-light"><i class="fas fa-lock"></i></span>
                    <input asp-for="Input.NewPassword" type="password" class="form-control" placeholder="Nhập mật khẩu mới" />
                </div>
                <span asp-validation-for="Input.NewPassword" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Xác nhận mật khẩu</label>
                <div class="input-group">
                    <span class="input-group-text bg-light"><i class="fas fa-lock"></i></span>
                    <input asp-for="Input.ConfirmPassword" type="password" class="form-control" placeholder="Nhập lại mật khẩu" />
                </div>
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100 fw-semibold" style="border-radius: 8px; transition: 0.3s;">
                Đặt Lại Mật Khẩu
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
