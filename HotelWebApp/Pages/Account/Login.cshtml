@page
@model HotelBusiness.Pages.Account.LoginModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Đăng Nhập";
}

<style>
    .login-container {
        background: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)), url('https://images.unsplash.com/photo-1551882547-ff40c63fe5fa?ixlib=rb-1.2.1&auto=format&fit=crop&w=1350&q=80');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        margin: 0;
        padding: 0;
    }
    .login-card {
        border: none;
        backdrop-filter: blur(10px);
        background-color: rgba(255, 255, 255, 0.9);
    }
    .btn-hotel {
        background-color: #003580;
        border: none;
        transition: all 0.3s;
    }
    .btn-hotel:hover {
        background-color: #002050;
        transform: translateY(-2px);
    }
    .divider {
        display: flex;
        align-items: center;
        text-align: center;
        color: #666;
    }
    .divider::before, .divider::after {
        content: "";
        flex: 1;
        border-bottom: 1px solid #ddd;
    }
    .divider::before {
        margin-right: 1rem;
    }
    .divider::after {
        margin-left: 1rem;
    }
</style>

<div class="login-container min-vh-100 d-flex justify-content-center align-items-center">
    <div class="col-md-5 col-lg-4 mx-3">
        <div class="login-card shadow-lg rounded-4 overflow-hidden">
            <div class="card-body p-4 p-md-5">
                <div class="text-center mb-4">
                    <h3 class="fw-bold" style="color: #003580;">Đăng Nhập Tài Khoản</h3>
                    <p class="text-muted">Nhập thông tin để tiếp tục</p>
                </div>

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger alert-dismissible fade show">
                        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <div>@error.ErrorMessage</div>
                        }
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                @if (TempData["InactiveAccount"] != null)
                {
                    <div class="alert alert-warning alert-dismissible fade show">
                        @TempData["InactiveAccount"]
                        <a asp-page="/Account/VerifyOtp" asp-route-email="@TempData["UserEmail"]" class="alert-link">Xác minh ngay</a>
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                <form method="post" class="needs-validation" novalidate>
                    <div class="mb-4">
                        <label for="emailOrUsername" class="form-label fw-medium">Email hoặc Tên đăng nhập</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white"><i class="fas fa-user text-muted"></i></span>
                            <input asp-for="Input.EmailOrUsername" class="form-control py-2" id="emailOrUsername" placeholder="Nhập email hoặc username" required />
                        </div>
                        <span asp-validation-for="Input.EmailOrUsername" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label for="password" class="form-label fw-medium">Mật khẩu</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white"><i class="fas fa-lock text-muted"></i></span>
                            <input asp-for="Input.Password" type="password" class="form-control py-2" id="password" placeholder="Nhập mật khẩu" required />
                        </div>
                        <span asp-validation-for="Input.Password" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="rememberMe">
                            <label class="form-check-label small" for="rememberMe">Ghi nhớ đăng nhập</label>
                        </div>
                        <a href="/account/forgotpassword" class="text-decoration-none small" style="color: #003580;">Quên mật khẩu?</a>
                    </div>

                    <button type="submit" class="btn btn-hotel text-white w-100 py-2 mb-3 fw-semibold rounded-3">
                        <i class="fas fa-sign-in-alt me-2"></i> ĐĂNG NHẬP
                    </button>

                    <div class="divider mb-3 small">hoặc đăng nhập bằng</div>

                    <div class="mt-3 text-center">
                        <a asp-page-handler="LoginWithGoogle" class="btn btn-danger w-100 fw-semibold" style="border-radius: 8px; transition: 0.3s;">
                            <i class="fab fa-google"></i> Đăng nhập với Google
                        </a>
                    </div>

                    <div class="text-center mt-4">
                        <span class="text-muted small">Chưa có tài khoản?</span>
                        <a href="/account/register" class="text-decoration-none small fw-bold ms-1" style="color: #003580;">Tạo tài khoản mới</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}