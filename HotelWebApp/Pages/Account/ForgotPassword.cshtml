@page
@model HotelWebApp.Pages.Account.ForgotPasswordModel
@{
    Layout = null;
    ViewData["Title"] = "Quên Mật Khẩu";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        .auth-container {
            background: linear-gradient(rgba(0, 0, 0, 0.7), rgba(0, 0, 0, 0.7)), url('https://images.unsplash.com/photo-1551882547-ff40c63fe5fa?ixlib=rb-1.2.1&auto=format&fit=crop&w=1350&q=80');
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            margin: 0;
            padding: 0;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .auth-box {
            background: rgba(255, 255, 255, 0.93);
            border-radius: 12px;
            box-shadow: 0 12px 24px rgba(0, 0, 0, 0.15);
            width: 90%;
            max-width: 420px;
            padding: 30px;
            animation: fadeIn 0.4s ease-out;
        }

        @@keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(-20px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .auth-title {
            color: #dc3545;
            position: relative;
            padding-bottom: 10px;
            margin-bottom: 20px;
            text-align: center;
        }

            .auth-title:after {
                content: '';
                position: absolute;
                bottom: 0;
                left: 50%;
                transform: translateX(-50%);
                width: 50px;
                height: 3px;
                background: #dc3545;
            }

        .form-control {
            height: 45px;
            border-radius: 5px;
            border: 1px solid #ddd;
            padding-left: 15px;
        }

            .form-control:focus {
                box-shadow: none;
                border-color: #dc3545;
            }

        .btn-auth {
            background: #dc3545;
            border: none;
            height: 45px;
            font-weight: 600;
            letter-spacing: 1px;
            transition: all 0.3s;
            border-radius: 5px;
        }

            .btn-auth:hover {
                background: #c82333;
                transform: translateY(-2px);
            }

        .input-group-text {
            background: #dc3545;
            color: white;
            border: none;
            width: 45px;
            justify-content: center;
        }

        .alert-danger {
            background: rgba(220, 53, 69, 0.1);
            border-color: #dc3545;
            color: #dc3545;
        }
    </style>
</head>
<body>
    <div class="auth-container">
        <div class="auth-box">
            <h3 class="auth-title">QUÊN MẬT KHẨU</h3>
            <p class="text-center text-muted mb-4">Nhập email hoặc tên đăng nhập để lấy lại mật khẩu</p>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger mb-4">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <p class="mb-1"><i class="fas fa-exclamation-circle me-2"></i>@error.ErrorMessage</p>
                    }
                </div>
            }

            <form method="post">
                <div class="mb-4">
                    <label class="form-label fw-semibold">Email hoặc Tên đăng nhập</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-user"></i></span>
                        <input asp-for="Input.EmailOrUsername" class="form-control" placeholder="Nhập email hoặc tên đăng nhập" />
                    </div>
                    <span asp-validation-for="Input.EmailOrUsername" class="text-danger small mt-1 d-block"></span>
                </div>

                <button type="submit" class="btn btn-auth w-100">
                    <i class="fas fa-paper-plane me-2"></i>GỬI OTP
                </button>

                <div class="text-center mt-4">
                    <a asp-page="/Account/Login" class="text-decoration-none text-danger fw-semibold">
                        <i class="fas fa-arrow-left me-2"></i>Quay lại đăng nhập
                    </a>
                </div>
            </form>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
</body>
</html>