@page
@model HotelWebApp.Pages.Admin.Rooms.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Room[0].Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Room[0].Price)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Room[0].Image)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Room[0].Status)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Room[0].IdroomTypeNavigation)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Room) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Price)
            </td>
            <td>
                <img src="@item.Image" alt="Room Image" width="100" height="100" />
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Status)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.IdroomTypeNavigation.TypeName)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.Idroom">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.Idroom">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.Idroom">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
